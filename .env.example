# Environment configuration for aws-ddos-eval.
#
#   cp .env.example .env     then edit the values below
#
# This file IS committed so anyone cloning the repository can see what needs
# setting. The .env you create from it is gitignored and stays on your machine.
#
# NOTE ON WHAT IS NOT HERE
# ------------------------
# Experiment parameters -- rate limit, evaluation window, Lambda memory,
# instance type -- are NOT in this file. They are Terraform variables in
# infra/*/main.tf, under version control with their rationale beside them,
# because a published result has to be traceable to the exact settings that
# produced it. Moving them here would hide them from anyone reading the repo.
#
# Resource identifiers -- distribution ids, web ACL ARNs, endpoint URLs -- are
# not here either. They are read live from Terraform outputs, because a cached
# identifier eventually goes stale and a collector then queries a resource that
# no longer exists, which returns an empty result rather than an error.
#
# Credentials are never in this repository. They live in ~/.aws/credentials.


# --- AWS account and region -------------------------------------------------

# Named profile from ~/.aws/credentials. Create it with:
#   aws configure --profile ddos-eval
AWS_PROFILE=ddos-eval

# Region for the regional resources: Lambda, API Gateway, EC2.
AWS_REGION=eu-west-1

# Fixed by AWS, not a preference. CLOUDFRONT-scope web ACLs, their log groups
# and CloudFront's own metrics only exist in us-east-1. Leave this alone.
AWS_GLOBAL_REGION=us-east-1


# --- naming -----------------------------------------------------------------

# Prefix on every resource name. Change it to run a second, isolated copy of
# the study in the same AWS account without name collisions.
NAME_PREFIX=ddos-eval

# API Gateway stage name. Appears in every metric dimension and log stream.
API_STAGE=exp


# --- cost guardrail ---------------------------------------------------------

# Used by scripts/setup_budget.py. Alerts fire at 50%, 80% and 100% of this,
# plus a forecast alert. Budget alerts NOTIFY, they do not stop spending.
BUDGET_AMOUNT_USD=50
BUDGET_EMAIL=you@example.com
